<!-- 新版 Canvas 2D API（基础库 >= 2.9.0） -->
<canvas wx:if="{{isUseNewCanvas}}" type="2d" class="ec-canvas"
  canvas-id="{{canvasId}}"
  bindtouchstart="touchStart"
  bindtouchmove="touchMove"
  bindtouchend="touchEnd"
></canvas>
<!-- 旧版 Canvas API -->
<canvas wx:else class="ec-canvas"
  canvas-id="{{canvasId}}"
  bindtouchstart="touchStart"
  bindtouchmove="touchMove"
  bindtouchend="touchEnd"
></canvas>
