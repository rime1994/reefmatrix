/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1677ff 0%, #e6f4ff 50%, #f5f5f5 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-header {
  padding-top: 80rpx;
  padding-bottom: 60rpx;
  text-align: center;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.logo-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 12rpx;
}

.login-form {
  width: 85%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

/* 头像选择 */
.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.avatar-hint {
  font-size: 22rpx;
  color: #bfbfbf;
  margin-top: 8rpx;
}

/* 昵称 */
.login-form .form-item {
  margin-bottom: 32rpx;
}

.login-form .form-label {
  font-size: 26rpx;
  color: #595959;
  margin-bottom: 12rpx;
  display: block;
}

.login-form .form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

/* 手机号授权 */
.phone-section {
  margin-bottom: 32rpx;
  text-align: center;
}

.btn-phone {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 88rpx;
  background: #f6ffed;
  color: #52c41a;
  border: 2rpx solid #b7eb8f;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 0;
  line-height: 88rpx;
}

.btn-phone::after {
  border: none;
}

.phone-icon {
  font-size: 32rpx;
}

.phone-hint {
  display: block;
  font-size: 22rpx;
  color: #bfbfbf;
  margin-top: 8rpx;
}

/* 登录按钮 */
.login-btn {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 16rpx;
  font-size: 32rpx;
  border-radius: 12rpx !important;
}

.login-btn[disabled] {
  background: #d9d9d9 !important;
  color: #ffffff !important;
}

/* 协议 */
.agreement {
  text-align: center;
  margin-top: 24rpx;
  font-size: 22rpx;
}

.agreement-text {
  color: #bfbfbf;
}

.agreement-link {
  color: #1677ff;
}

/* 开发模式 */
.dev-badge {
  text-align: center;
  font-size: 22rpx;
  color: #fa8c16;
  background: #fff7e6;
  border: 2rpx solid #ffd591;
  border-radius: 8rpx;
  padding: 6rpx 0;
  margin-bottom: 24rpx;
}

.dev-toggle {
  text-align: center;
  margin-bottom: 8rpx;
}

.dev-toggle-text {
  font-size: 26rpx;
  color: #1677ff;
}
