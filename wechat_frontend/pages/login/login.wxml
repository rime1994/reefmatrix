<!-- pages/login/login.wxml — 微信登录 -->
<view class="login-page">
  <view class="login-header">
    <view class="logo-area">
      <text class="logo-text">ReefMatrix</text>
      <text class="logo-sub">海水鱼缸智能管理</text>
    </view>
  </view>

  <view class="login-form">

    <!-- ========== 开发模式：手机号 + 密码 ========== -->
    <block wx:if="{{isDev}}">
      <view class="dev-badge">开发模式</view>

      <!-- 头像（可选） -->
      <view class="avatar-section">
        <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image
            class="avatar-img"
            src="{{avatarUrl || '/assets/icons/mine.png'}}"
            mode="aspectFill"
          />
          <text class="avatar-hint">点击选择头像（可选）</text>
        </button>
      </view>

      <!-- 昵称（注册时可选） -->
      <view class="form-item" wx:if="{{devIsRegister}}">
        <text class="form-label">昵称</text>
        <input
          class="form-input"
          type="nickname"
          placeholder="请输入昵称（可选）"
          value="{{nickname}}"
          bindchange="onNicknameChange"
        />
      </view>

      <!-- 手机号 -->
      <view class="form-item">
        <text class="form-label">手机号</text>
        <input
          class="form-input"
          type="text"
          placeholder="请输入手机号"
          value="{{devPhone}}"
          bindinput="onDevPhoneInput"
        />
      </view>

      <!-- 密码 -->
      <view class="form-item">
        <text class="form-label">密码</text>
        <input
          class="form-input"
          type="text"
          password="{{true}}"
          placeholder="请输入密码（至少6位）"
          value="{{devPassword}}"
          bindinput="onDevPasswordInput"
        />
      </view>

      <!-- 登录 / 注册切换 -->
      <view class="dev-toggle" bindtap="onToggleDevMode">
        <text class="dev-toggle-text">
          {{devIsRegister ? '已有账号？去登录' : '没有账号？去注册'}}
        </text>
      </view>
    </block>

    <!-- ========== 正式环境：微信授权 ========== -->
    <block wx:else>
      <!-- 头像选择 -->
      <view class="avatar-section">
        <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image
            class="avatar-img"
            src="{{avatarUrl || '/assets/icons/mine.png'}}"
            mode="aspectFill"
          />
          <text class="avatar-hint">点击选择头像</text>
        </button>
      </view>

      <!-- 昵称输入 -->
      <view class="form-item">
        <text class="form-label">昵称</text>
        <input
          class="form-input"
          type="nickname"
          placeholder="请输入昵称"
          value="{{nickname}}"
          bindchange="onNicknameChange"
        />
      </view>

      <!-- 手机号获取 -->
      <view class="phone-section">
        <button
          class="btn-phone"
          open-type="getPhoneNumber"
          bindgetphonenumber="onGetPhoneNumber"
        >
          <text class="phone-icon">📱</text>
          <text>{{phone ? phone : '授权手机号'}}</text>
        </button>
        <text class="phone-hint" wx:if="{{!phone}}">用于登录和账号绑定</text>
      </view>
    </block>

    <!-- 登录按钮（通用） -->
    <button
      class="btn-primary login-btn"
      loading="{{loading}}"
      disabled="{{loading || !canLogin}}"
      bindtap="onLogin"
    >
      {{isDev ? (devIsRegister ? '注册' : '登录') : '开始使用'}}
    </button>

    <view class="agreement">
      <text class="agreement-text">登录即表示同意</text>
      <text class="agreement-link">用户协议</text>
      <text class="agreement-text">和</text>
      <text class="agreement-link">隐私政策</text>
    </view>
  </view>
</view>
