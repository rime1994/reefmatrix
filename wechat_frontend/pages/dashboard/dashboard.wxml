<!-- pages/dashboard/dashboard.wxml — 水质看板 -->
<view class="container">

  <!-- 未登录欢迎页 -->
  <view class="welcome" wx:if="{{!isLoggedIn}}">
    <view class="welcome-icon">🐠</view>
    <text class="welcome-title">ReefMatrix</text>
    <text class="welcome-sub">专业的海水鱼缸管理助手</text>
    <view class="welcome-features">
      <view class="feature-item">📊 水质监测与趋势分析</view>
      <view class="feature-item">🐟 生物资产追踪</view>
      <view class="feature-item">⏰ 维护提醒不遗漏</view>
    </view>
    <button class="btn-primary welcome-btn" bindtap="onGoLogin">
      微信快速登录，开始使用
    </button>
  </view>

  <!-- 已登录 -->
  <block wx:if="{{isLoggedIn}}">

    <!-- 无鱼缸提示 -->
    <view class="empty" wx:if="{{!loading && tanks.length === 0}}">
      <text>还没有鱼缸</text>
      <button class="btn-primary" style="margin-top: 24rpx;" bindtap="onCreateTank">创建鱼缸</button>
    </view>

    <block wx:if="{{tanks.length > 0}}">

      <!-- ① 鱼缸头部卡片 -->
      <view class="header-card">
        <view class="header-top">
          <picker
            mode="selector"
            range="{{tankNames}}"
            value="{{tankIndex}}"
            bindchange="onTankChange"
            style="flex: 1; min-width: 0;"
          >
            <view class="header-picker-row">
              <text class="header-tank-name">{{currentTank.name || '选择鱼缸'}}</text>
              <view class="header-type-badge">{{currentTank.tank_type ? currentTank.tank_type.toUpperCase() : 'SPS'}}</view>
              <text class="header-chevron">▾</text>
            </view>
          </picker>
          <button class="btn-record" bindtap="onRecordParam">+ 录入</button>
        </view>

        <!-- 状态汇总行 -->
        <view class="status-row" wx:if="{{paramCards.length > 0}}">
          <view class="status-item">
            <text class="status-num num-safe">{{safeCount}}</text>
            <text class="status-lbl">正常</text>
          </view>
          <view class="status-sep"></view>
          <view class="status-item">
            <text class="status-num num-warn">{{warnCount}}</text>
            <text class="status-lbl">异常</text>
          </view>
          <view class="status-sep"></view>
          <view class="status-item">
            <text class="status-num num-nodata">{{nodataCount}}</text>
            <text class="status-lbl">待测</text>
          </view>
        </view>
      </view>

      <!-- ② 水质参数卡片（2 列，点击查看趋势图） -->
      <view class="params-grid" wx:if="{{currentTank}}">
        <view
          class="param-card"
          wx:for="{{paramCards}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onParamTap"
          style="border-left-color: {{item.status === 'warn' ? '#ef4444' : item.status === 'safe' ? item.color : '#e2e8f0'}};"
        >
          <view class="param-top-row">
            <text class="param-label">{{item.label}}</text>
            <view class="param-dot {{item.status === 'safe' ? 'dot-safe' : item.status === 'warn' ? 'dot-warn' : 'dot-nodata'}}"></view>
          </view>
          <view class="param-val-row">
            <text class="param-value" style="color: {{item.value ? item.color : '#94a3b8'}}">{{item.value || '—'}}</text>
            <text class="param-unit" wx:if="{{item.value && item.unit}}"> {{item.unit}}</text>
          </view>
          <text class="param-range">{{item.rangeMin}}–{{item.rangeMax}}{{item.unit ? ' '+item.unit : ''}}</text>
          <text class="param-time">{{item.timeAgo || ' '}}</text>
        </view>
      </view>

      <!-- ③ 近期操作记录（时间轴样式） -->
      <view class="card" wx:if="{{currentTank}}">
        <text class="card-title">近期操作记录</text>
        <view wx:if="{{operations.length === 0}}" class="empty" style="padding: 32rpx 0;">
          <text>暂无操作记录，录入水质时可填写</text>
        </view>
        <view wx:else class="op-list">
          <view class="op-item" wx:for="{{operations}}" wx:key="id">
            <view class="op-timeline">
              <view class="op-dot"></view>
              <view class="op-line" wx:if="{{index < operations.length - 1}}"></view>
            </view>
            <view class="op-content">
              <text class="op-time">{{item.shortTime}}</text>
              <text class="op-text">{{item.notes}}</text>
            </view>
          </view>
        </view>
      </view>

    </block>
  </block>
</view>

<!-- ── 图表半屏弹窗 ────────────────────────── -->
<view class="chart-overlay {{chartVisible ? 'show' : ''}}" bindtap="onCloseChart">
  <view class="chart-popup" catchtap="">
    <view class="chart-handle"></view>
    <view class="chart-header">
      <view class="chart-header-left">
        <view class="chart-color-dot" style="background: {{chartColor}};"></view>
        <text class="chart-title">{{chartTitle}}</text>
      </view>
      <text class="chart-close" bindtap="onCloseChart">✕</text>
    </view>
    <view class="chart-body">
      <ec-canvas
        wx:if="{{chartVisible}}"
        id="param-chart"
        canvas-id="param-chart-canvas"
        ec="{{ecConfig}}"
      ></ec-canvas>
    </view>
  </view>
</view>
