/* pages/dashboard/dashboard.wxss — 重设计 */

/* ── 页面背景覆盖 ─────────────────────────── */
page {
  background-color: #f0f9ff;
}

/* ── 欢迎页 ──────────────────────────────── */
.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.welcome-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.welcome-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #0c4a6e;
}

.welcome-sub {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.welcome-features {
  margin-top: 56rpx;
  margin-bottom: 56rpx;
  width: 100%;
}

.feature-item {
  font-size: 28rpx;
  color: #475569;
  padding: 20rpx 0;
  text-align: center;
}

.welcome-btn {
  width: 80% !important;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx !important;
}

/* ── 头部鱼缸卡片 ────────────────────────── */
.header-card {
  background: linear-gradient(145deg, #ffffff 0%, #f0f9ff 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e0f2fe;
  box-shadow: 0 2rpx 12rpx rgba(12, 74, 110, 0.08);
}

.header-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.header-picker-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.header-tank-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #0c4a6e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.header-type-badge {
  background: #e0f2fe;
  color: #0891b2;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.header-chevron {
  color: #94a3b8;
  font-size: 24rpx;
  flex-shrink: 0;
}

.btn-record {
  flex-shrink: 0;
  background: #0891b2;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  margin: 0;
  white-space: nowrap;
}

.btn-record:active {
  background: #0e7490;
  opacity: 0.9;
}

/* 状态汇总行 */
.status-row {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 16rpx 0;
  border: 1rpx solid #f1f5f9;
}

.status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.status-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.num-safe   { color: #22c55e; }
.num-warn   { color: #ef4444; }
.num-nodata { color: #94a3b8; }

.status-lbl {
  font-size: 20rpx;
  color: #94a3b8;
  letter-spacing: 0.5rpx;
}

.status-sep {
  width: 1rpx;
  height: 48rpx;
  background: #e2e8f0;
}

/* ── 参数网格（2 列）────────────────────── */
.params-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.param-card {
  background: #ffffff;
  border-radius: 16rpx;
  border-left: 6rpx solid #e2e8f0;
  padding: 18rpx 18rpx 16rpx 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(12, 74, 110, 0.07);
  position: relative;
  transition: transform 0.1s, opacity 0.1s;
}

.param-card:active {
  transform: scale(0.97);
  opacity: 0.88;
}

.param-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.param-label {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
}

.param-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.dot-safe   { background: #22c55e; }
.dot-warn   { background: #ef4444; }
.dot-nodata { background: #cbd5e1; }

.param-val-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.param-value {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.param-unit {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 400;
}

.param-range {
  display: block;
  font-size: 18rpx;
  color: #94a3b8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.param-time {
  display: block;
  font-size: 18rpx;
  color: #cbd5e1;
  min-height: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 2rpx;
}

/* ── 操作记录（时间轴）──────────────────── */
.op-list {
  display: flex;
  flex-direction: column;
}

.op-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.op-timeline {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 6rpx;
  width: 20rpx;
  flex-shrink: 0;
}

.op-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background: #0891b2;
  flex-shrink: 0;
}

.op-line {
  width: 2rpx;
  flex: 1;
  min-height: 32rpx;
  background: #e0f2fe;
  margin-top: 6rpx;
}

.op-content {
  flex: 1;
  padding-bottom: 24rpx;
}

.op-time {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 4rpx;
}

.op-text {
  display: block;
  font-size: 26rpx;
  color: #0c4a6e;
  line-height: 1.5;
}

/* ── 图表半屏弹窗 ────────────────────────── */
.chart-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(12, 74, 110, 0.4);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.25s, visibility 0.25s;
}

.chart-overlay.show {
  visibility: visible;
  opacity: 1;
}

.chart-popup {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
}

.chart-overlay.show .chart-popup {
  transform: translateY(0);
}

/* 顶部拖动把手 */
.chart-handle {
  width: 64rpx;
  height: 8rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
  margin: 16rpx auto 4rpx;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx 18rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.chart-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.chart-color-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.chart-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0c4a6e;
}

.chart-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 8rpx 4rpx 8rpx 24rpx;
}

.chart-body {
  width: 100%;
  height: 480rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.chart-body ec-canvas {
  width: 100%;
  height: 100%;
}
