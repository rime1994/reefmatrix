/* app.wxss — 全局样式 */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #262626;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0c4a6e;
  margin-bottom: 16rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.tag-blue    { background: #e6f4ff; color: #1677ff; }
.tag-green   { background: #f6ffed; color: #52c41a; }
.tag-red     { background: #fff2f0; color: #ff4d4f; }
.tag-orange  { background: #fff7e6; color: #fa8c16; }
.tag-cyan    { background: #e6fffb; color: #13c2c2; }
.tag-purple  { background: #f9f0ff; color: #722ed1; }
.tag-default { background: #fafafa; color: #8c8c8c; }

/* 按钮 */
.btn-primary {
  background: #1677ff;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-primary:active {
  background: #0958d9;
}

.btn-default {
  background: #ffffff;
  color: #262626;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: #bfbfbf;
  font-size: 26rpx;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

/* 表单 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #595959;
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #1677ff;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 24rpx 0;
}

/* flex 工具类 */
.flex-row    { display: flex; flex-direction: row; align-items: center; }
.flex-col    { display: flex; flex-direction: column; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center  { display: flex; justify-content: center; align-items: center; }
.flex-1       { flex: 1; }
