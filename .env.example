# ── 数据库 ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=reefmatrix
DB_PASSWORD=reefmatrix_dev
DB_NAME=reefmatrix

# ── 认证 ──────────────────────────────────
